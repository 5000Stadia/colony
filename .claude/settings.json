{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "colony notes --deliver --session"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "colony context --hook restore --console claude"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "colony notes --deliver"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "colony context --hook restore --console claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "colony turn"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "colony context --hook before --console claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "colony statusline"
  }
}
